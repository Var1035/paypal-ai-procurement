# ============================================================
# AgentMarket — Environment Variables Template
# All secrets and API credentials must be set here for the backend.
# Never commit real credentials to version control.
# ============================================================

# --- Server Core Settings ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Frontend Client Configuration (Vite) ---
# In development, Vite dev-server proxies /api to http://localhost:5000
VITE_API_URL=/api

# --- Relational Database & Auth: Supabase (PostgreSQL) ---
# Used for authoritative records, tenant isolation, and audit logs
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Graph Database: FalkorDB (RedisGraph compatible) ---
# Used for relationship reasoning, historical comparability, and supplier delivery scoring
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# --- Payments: PayPal Sandbox ---
# Used for server-side order creation, checkout capture, and verification
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# --- LLM Provider: Google Gemini ---
# Used for natural-language requirement parsing and draft agent communications
GEMINI_API_KEY=your-gemini-api-key
